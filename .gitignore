# 依赖（本项目运行期零依赖，仅测试用的 jsdom 属可选开发依赖）
node_modules/
package-lock.json
npm-debug.log*
yarn-error.log*

# 本地运行产物：扫描状态、快照、日志。属于每次运行自己生成的数据，
# 不随仓库分发，也不含任何密钥。
data/
*.log
logs/

# 自定义域名：cname.txt 是本地开关，产物写进 docs/CNAME。
# 分发仓库时默认只带 cname.example。
cname.txt

# 环境变量与本地配置
.env
.env.*
*.local
config.local.*

# 编辑器 / 系统
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# 临时文件
*.tmp
*.bak
.tmp-*
